mail_config.py
settings.json

# ============================================================
#  运行时生成
# ============================================================
__pycache__/
*.py[cod]
*.log
build/
dist/

# 读数 CSV 每天自动生成，只保留仓库自带的模拟数据
csv_data/*.csv
!csv_data/*-demo.csv

# ============================================================
#  模型权重：子目录里的单文件 200MB+，超过 GitHub 单文件 100MB 上限
#  （注意要用 ** 递归匹配，model/*.pdiparams 只匹配一级目录）
#  获取方式见 model/README.md
# ============================================================
model/**/*.pdiparams
model/**/*.pdiparams.info
model/**/*.pdmodel
model/**/*.yml
model/**/*.xml
model/**/*.bin

# ============================================================
#  编辑器与临时文件
# ============================================================
.idea/
.vscode/
.ipynb_checkpoints/
*.bak
*~
